include_guard(GLOBAL)
function(morok_configure_compiler_options target)
 if(MSVC)
  target_compile_options(${target} INTERFACE /W4)
  if(MOROK_WARNINGS_AS_ERRORS)
   target_compile_options(${target} INTERFACE /WX)
  endif()
 elseif(CMAKE_CXX_COMPILER_ID MATCHES "GNU|Clang|AppleClang")
  target_compile_options(${target} INTERFACE -Wall -Wextra -Wpedantic -Wconversion -Wsign-conversion -Wshadow -Wnon-virtual-dtor -Wold-style-cast -Woverloaded-virtual)
  if(MOROK_WARNINGS_AS_ERRORS)
   target_compile_options(${target} INTERFACE -Werror)
  endif()
 endif()
endfunction()
