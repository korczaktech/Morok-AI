include_guard(GLOBAL)
function(morok_enable_sanitizers target)
 if(NOT MOROK_ENABLE_ASAN AND NOT MOROK_ENABLE_UBSAN)
  return()
 endif()
 if(NOT CMAKE_CXX_COMPILER_ID MATCHES "GNU|Clang")
  message(FATAL_ERROR "Morok sanitizers require GCC or Clang.")
 endif()
 set(_sanitizers "")
 if(MOROK_ENABLE_ASAN)
  list(APPEND _sanitizers address)
 endif()
 if(MOROK_ENABLE_UBSAN)
  list(APPEND _sanitizers undefined)
 endif()
 list(JOIN _sanitizers "," _flags)
 target_compile_options(${target} PRIVATE "-fsanitize=${_flags}" -fno-omit-frame-pointer)
 target_link_options(${target} PRIVATE "-fsanitize=${_flags}" -fno-omit-frame-pointer)
endfunction()
